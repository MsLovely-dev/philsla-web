DJANGO_SECRET_KEY="change-me"
DJANGO_DEBUG="true"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
DJANGO_CSRF_TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"
DJANGO_CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"
DJANGO_SECURE_SSL_REDIRECT="false"
DJANGO_SECURE_HSTS_SECONDS="0"
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS="false"
DJANGO_SECURE_HSTS_PRELOAD="false"

# Supabase Postgres connection string. Do not commit real credentials.
DATABASE_URL=""

# Authentication defaults from ADR-011. Override only with an approved security change.
AUTH_ACCESS_TOKEN_LIFETIME_MINUTES="15"
AUTH_REFRESH_TOKEN_LIFETIME_DAYS="7"
AUTH_PENDING_TOKEN_TTL_MINUTES="10"
AUTH_OTP_TTL_MINUTES="5"
AUTH_OTP_RESEND_COOLDOWN_SECONDS="60"
AUTH_OTP_MAX_RESENDS="3"
AUTH_OTP_MAX_ATTEMPTS="5"
AUTH_PASSWORD_MAX_ATTEMPTS="5"
AUTH_PASSWORD_LOCKOUT_MINUTES="15"
AUTH_STUDENT_IDLE_TIMEOUT_MINUTES="20"
AUTH_STAFF_IDLE_TIMEOUT_MINUTES="10"
AUTH_STUDENT_ABSOLUTE_TIMEOUT_HOURS="12"
AUTH_STAFF_ABSOLUTE_TIMEOUT_HOURS="8"

# Local manual-login helper. Keep disabled outside local development.
AUTH_LOCAL_EXPOSE_OTP="false"

# Future auth email delivery provider. Azure is configured for future use but not wired to OTP yet.
AUTH_EMAIL_PROVIDER="console"
AZURE_COMMUNICATION_EMAIL_ENABLED="false"
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=""
AZURE_COMMUNICATION_EMAIL_ENDPOINT=""
AZURE_COMMUNICATION_EMAIL_SENDER=""
# Synthetic LRN registry is for local development only. Production integration remains TBD.
ACTIVE_EXAM_CYCLE_ID=2026
LRN_REGISTRY_PROVIDER=mock
LRN_VERIFICATION_TTL_MINUTES=15
LRN_MAX_FAILED_ATTEMPTS=5
LRN_FAILED_ATTEMPT_WINDOW_MINUTES=15
STEP2_DOCUMENT_RECOGNITION_PROVIDER=mock
STEP1_SELFIE_FACE_PROVIDER=opencv
STEP1_SELFIE_MIN_IMAGE_WIDTH=720
STEP1_SELFIE_MIN_IMAGE_HEIGHT=720
STEP1_SELFIE_MIN_FACE_RATIO=0.20
STEP1_SELFIE_MAX_FACE_RATIO=0.70
STEP1_SELFIE_MIN_LAPLACIAN_VARIANCE=100
STEP1_SELFIE_MIN_BRIGHTNESS=60
STEP1_SELFIE_MAX_BRIGHTNESS=200
